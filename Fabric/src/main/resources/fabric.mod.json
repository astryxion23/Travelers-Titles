{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_full_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "YUNGNICKYOUNG"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_homepage}",
    "issues": "${mod_homepage}/issues"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yungnickyoung.minecraft.travelerstitles.TravelersTitlesFabric"
    ],
    "modmenu": [
      "com.yungnickyoung.minecraft.travelerstitles.config.gui.TTModMenu"
    ]
  },
  "mixins": [
    "travelerstitles.mixins.json",
    "travelerstitles_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": ">=${fabric_version}",
    "minecraft": "${mc_version_range_fabric}",
    "cloth-config2": ">=${clothconfig_version_fabric}",
    "java": ">=${java_version}"
  }
}